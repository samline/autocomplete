{
  "name": "@samline/autocomplete",
  "version": "3.1.0",
  "description": "An accessible, framework-agnostic autocomplete (combobox) for vanilla JavaScript, TypeScript and plain HTML.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://samline.github.io/autocomplete/",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/browser/autocomplete.global.js",
    "./dist/browser/global.global.js",
    "./dist/style.css",
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./browser/global": {
      "default": "./dist/browser/autocomplete.global.js"
    },
    "./styles.css": "./dist/styles.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "pack:check": "pnpm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run clean && bun run build && bun run typecheck && bun run test:coverage && bun run test:package",
    "site:dev": "node site-tools/assets.mjs && node site-tools/dev.mjs",
    "site:build": "node site-tools/assets.mjs && bun run --cwd docs build && bun run --cwd landing build && node site-tools/assemble.mjs && node site-tools/check-site.mjs",
    "site:preview": "node site-tools/preview.mjs",
    "site:check": "node site-tools/assets.mjs && node site-tools/check-config.mjs && bun run site:check:design && bun run --cwd landing check && bun run --cwd docs check",
    "site:format": "prettier --plugin prettier-plugin-astro --write landing docs/src docs/scripts shared site-tools site-tests site-e2e skills playwright.site.config.ts project.config.json content-audit.json design-reference.json SITE.md --ignore-path .site-prettierignore",
    "site:format:check": "prettier --plugin prettier-plugin-astro --check landing docs/src docs/scripts shared site-tools site-tests site-e2e skills playwright.site.config.ts project.config.json content-audit.json design-reference.json SITE.md --ignore-path .site-prettierignore",
    "site:test": "node --test site-tests/*.test.mjs",
    "site:test:browser": "playwright test --config playwright.site.config.ts",
    "site:verify": "bun run site:check && bun run site:format:check && bun run site:test && bun run site:test:adaptation && bun run site:build && bun run site:check:identity && bun run site:check:content && bun run site:test:browser",
    "site:configure": "node site-tools/configure.mjs",
    "site:check:release": "bun run site:check:identity && node site-tools/check-release.mjs",
    "site:check:content": "node site-tools/check-content.mjs",
    "site:migrate:starlight": "node site-tools/migrate-starlight.mjs",
    "site:accent": "node site-tools/accent-pair.mjs",
    "site:test:adaptation": "node site-tools/test-adaptation.mjs",
    "site:check:design": "node site-tools/check-design.mjs",
    "site:check:identity": "node site-tools/check-identity.mjs",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "check": "bun run format:check && bun run typecheck && bun run test:coverage && bun run build && bun run size && bun run test:package && bun run test:e2e",
    "release": "bun run check && pnpm publish"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samline/autocomplete.git"
  },
  "bugs": {
    "url": "https://github.com/samline/autocomplete/issues"
  },
  "keywords": [
    "autocomplete",
    "combobox",
    "typeahead",
    "search",
    "accessibility",
    "aria"
  ],
  "author": "Samuel Olvera (samline)",
  "packageManager": "pnpm@12.9.1",
  "unpkg": "./dist/browser/autocomplete.global.js",
  "jsdelivr": "./dist/browser/autocomplete.global.js",
  "size": {
    "dist/index.js": 9250,
    "dist/core/index.js": 3300,
    "dist/vanilla/index.js": 8100,
    "dist/browser/index.js": 8900,
    "dist/browser/autocomplete.global.js": 8850
  }
}
