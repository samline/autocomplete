---
import { sitePath } from '../../shared/lib/project.mjs'
import '../../dist/styles.css'
import './_shared.css'
// Landing and Docs share one site root, where cities.json is served.
const endpoint = sitePath('cities.json')
---

<div class="preview" data-preview="render" data-endpoint={endpoint}>
  <div class="field">
    <label for="preview-destination">Destination</label>
    <input id="preview-destination" type="text" />
  </div>
</div>

<script>
  import { createAutocomplete } from '@samline/autocomplete'
  type City = { key: string; name: string; country: string }
  const root = document.querySelector<HTMLElement>('[data-preview="render"]')!
  createAutocomplete<City>('#preview-destination', {
    endpoint: root.dataset.endpoint!,
    minLength: 1,
    maxResults: 5,
    mapResponse: (payload, _response, query) =>
      (payload as { results: City[] }).results.filter(city =>
        city.name.toLowerCase().includes(query.toLowerCase())
      ),
    getId: city => city.key,
    getLabel: city => city.name,
    renderOption: (option, city) => {
      const country = document.createElement('small')
      country.textContent = city.country
      option.append(country)
    },
  })
</script>
