---
import { sitePath } from '../../shared/lib/project.mjs'
import '../../dist/style.css'
import './_shared.css'
import examples from '../advanced-examples'
interface Props {
  id: string
}
const example = examples.find(item => item.id === Astro.props.id)!
// Previews read this site's own cities.json (served at the shared site root,
// for Landing and Docs alike) instead of the published copy.
const endpoint = sitePath('cities.json')
const html = example.files.html.replace(
  'https://samline.github.io/autocomplete/cities.json',
  endpoint
)
---

<style is:inline set:html={example.files.css} />
<div class="preview" data-advanced-preview={example.id} set:html={html} />

<script>
  import { createAutocomplete, createSearch } from '@samline/autocomplete'
  import { mountElements } from '../../shared/lib/mount-elements'
  import { setupPills } from './behaviors/pills.js'
  import { setupHooks } from './behaviors/hooks.js'
  import { setupPlugins } from './behaviors/plugins.js'
  import { setupState } from './behaviors/state.js'
  import { setupRendering } from './behaviors/rendering.js'
  import { setupHeadless } from './behaviors/headless.js'
  import { setupPalette } from './behaviors/palette.js'
  import { setupDependent } from './behaviors/dependent.js'

  mountElements('[data-advanced-preview]', root => {
    if (root.dataset.advancedPreview === 'headless') return setupHeadless(root, createSearch)
    const setup = {
      pills: setupPills,
      hooks: setupHooks,
      plugins: setupPlugins,
      state: setupState,
      rendering: setupRendering,
      palette: setupPalette,
      dependent: setupDependent,
    }[root.dataset.advancedPreview!]
    return setup?.(root, createAutocomplete)
  })
</script>
