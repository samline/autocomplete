---
import { sitePath } from '../../shared/lib/project.mjs'
import '../../dist/style.css'
import './_shared.css'
// Landing and Docs share one site root, where cities.json is served.
const endpoint = sitePath('cities.json')
---

<div class="preview" data-preview="basic" data-endpoint={endpoint}>
  <div class="field">
    <label for="preview-city">City</label>
    <input id="preview-city" type="text" />
  </div>
  <p class="note" aria-live="polite">
    Nothing selected yet.
  </p>
</div>

<script>
  import { createAutocomplete } from '@samline/autocomplete'
  import { preview } from '../../shared/lib/preview'
  type City = { key: string; name: string; country: string }

  preview('basic', stage => {
    const root = stage.querySelector<HTMLElement>('[data-preview="basic"]')!
    const note = root.querySelector('.note')!
    const controller = createAutocomplete<City>('#preview-city', {
      endpoint: root.dataset.endpoint!,
      minLength: 2,
      mapResponse: (payload, _response, query) =>
        (payload as { results: City[] }).results.filter(city =>
          city.name.toLowerCase().includes(query.toLowerCase())
        ),
      getId: city => city.key,
      getLabel: city => `${city.name}, ${city.country}`,
      getValue: city => city.name,
      onSelect: city => {
        note.textContent = `Selected ${city.name}.`
      },
    })
    return controller
  })
</script>
